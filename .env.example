# Google OAuth Web application credentials
GOOGLE_CLIENT_ID=replace-with-your-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-client-secret

# Required locally. Render derives this automatically from its public hostname.
GOOGLE_REDIRECT_URL=http://127.0.0.1:8080/auth/google/callback

# Local service addresses. Render's Docker setup uses these same defaults.
ML_API_URL=http://127.0.0.1:8000
PORT=8080
